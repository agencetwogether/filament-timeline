{
    "name": "agencetwogether/filament-timeline",
    "description": "A beautiful Timeline for Filament",
    "keywords": [
        "agencetwogether",
        "filamentphp",
        "timeline"
    ],
    "homepage": "https://github.com/agencetwogether/filament-timeline",
    "support": {
        "issues": "https://github.com/agencetwogether/filament-timeline/issues",
        "source": "https://github.com/agencetwogether/filament-timeline"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Max",
            "email": "contact@agencetwogether.fr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Agencetwogether\\FilamentTimeline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Agencetwogether\\FilamentTimeline\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse --memory-limit 1G",
        "lint": "pint",
        "lint:blade": "npm run format:check",
        "lint:all": [
            "@lint",
            "@lint:blade"
        ],
        "format:blade": "npm run format"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Agencetwogether\\FilamentTimeline\\FilamentTimelineServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
